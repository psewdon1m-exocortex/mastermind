FROM python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS runtime-base
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    ca-certificates curl openbox dbus-x11 xauth x11-utils xclip procps \
    libnss3 libatk1.0-0t64 libatk-bridge2.0-0t64 libcups2t64 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2t64 \
    libgtk-3-0t64 libsecret-1-0 libnotify4 fonts-liberation fonts-noto-color-emoji \
    && curl --fail --location --proto '=https' --tlsv1.2 \
    https://github.com/kasmtech/KasmVNC/releases/download/v1.5.0/kasmvncserver_trixie_1.5.0_amd64.deb \
    -o /tmp/kasm.deb \
    && echo '80b241de7dfe53bba2b7e1cc5ac8c5246d72271efa16be2d4f76607f30fab1c4  /tmp/kasm.deb' | sha256sum -c - \
    && apt-get install -y --no-install-recommends /tmp/kasm.deb \
    && curl --fail --location --proto '=https' --tlsv1.2 \
    https://github.com/obsidianmd/obsidian-releases/releases/download/v1.13.7/Obsidian-1.13.7.AppImage \
    -o /tmp/obsidian.AppImage \
    && echo 'e0d8e0a611624de8c9c7dcd8a9e648279fb0a0d552faa1312b7e4f3a5fa72663  /tmp/obsidian.AppImage' | sha256sum -c - \
    && chmod 755 /tmp/obsidian.AppImage \
    && cd /opt && /tmp/obsidian.AppImage --appimage-extract >/dev/null \
    && mv squashfs-root obsidian \
    && chmod -R a+rX /opt/obsidian \
    && useradd --uid 10001 --create-home --shell /bin/bash mastermind \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/* /tmp/kasm.deb /tmp/obsidian.AppImage
ENV DISPLAY=:1 HOME=/home/mastermind PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
USER 10001:10001

FROM runtime-base AS runtime
USER root
WORKDIR /app
COPY requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir -r requirements.lock
COPY src/mastermind/__init__.py src/mastermind/runtime_supervisor.py src/mastermind/bridge_artifacts.py src/mastermind/fs.py src/mastermind/deadline.py src/mastermind/errors.py src/mastermind/secret_store.py /app/src/mastermind/
COPY runtime /app/runtime
COPY bridge/dist /app/bridge
ENV PYTHONPATH=/app/src
USER 10001:10001
ENTRYPOINT ["python", "-m", "mastermind.runtime_supervisor"]
