# Render placeholders explicitly; this file never changes or reloads host Nginx.
# Include mastermind-http.conf once in http {}. Supply a valid existing TLS cert.
server {
    listen 443 ssl;
    server_name __MASTERMIND_HOST__;
    ssl_certificate __MASTERMIND_CERTIFICATE__;
    ssl_certificate_key __MASTERMIND_CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    if ($host != __MASTERMIND_HOST__) { return 444; }
    if ($ssl_server_name != __MASTERMIND_HOST__) { return 444; }
    access_log /var/log/nginx/mastermind-access.log mastermind_safe;
    # Native Nginx error messages include raw URIs and cannot redact capabilities.
    # Structured Core errors and the redacted access log retain outcome evidence.
    error_log /dev/null emerg;
    client_max_body_size 1m;
    client_body_timeout 30s;
    send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
    limit_conn mastermind_connections 24;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /healthz {
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
    }
    location = /readyz { return 404; }
    location = /internal/gryphon/command {
        limit_except POST { deny all; }
        client_max_body_size 8k;
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
    }
    location ^~ /internal/ { return 404; }
    location ^~ /api/internal/ { return 404; }
    location ^~ /v1/ { return 404; }
    location = /api/auth/login {
        limit_req zone=mastermind_login burst=6 nodelay;
        limit_req_status 429;
        client_max_body_size 256k;
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
    }
    location = /runtime/websockify {
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $mastermind_upgrade;
        proxy_read_timeout 12h;
        proxy_send_timeout 12h;
    }
    location ~ ^/api/owner/updates/[a-f0-9]+/saved-backup$ {
        client_max_body_size 8g;
        client_body_timeout 120s;
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
    location ~ ^/api/owner/operations/[a-f0-9]+/content$ {
        client_max_body_size 8g;
        client_body_timeout 120s;
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
    location ~ ^/api/v1/crusher/uploads/[a-f0-9]+/content$ {
        client_max_body_size 2g;
        client_body_timeout 120s;
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
    location ^~ /s/ {
        client_max_body_size 2m;
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
    }
    location ~ ^/(?:api/(?:auth|owner|v1|search|index|notes|note|graph|activity|status|logs|exports|runtime|appearance)(?:/|$)|runtime/(?:index\.html|assets/)|assets/|(?:login|dashboard|vault|crusher|analytics|shares|settings|documentation|robots\.txt)$) {
        client_max_body_size 16m;
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
    }
    location = / {
        include /opt/exocortex/mastermind/packaging/nginx/mastermind-proxy.conf;
    }
    location / { return 404; }
}
