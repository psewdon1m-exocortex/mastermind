FROM python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea AS browser
COPY worker-browser.lock.json /browser.lock.json
COPY scripts/install_worker_browser.py /install-browser.py
RUN python /install-browser.py --lock /browser.lock.json --destination /browser

FROM python:3.12-slim-trixie@sha256:78387bc3881b8273120a12ebe6c1ab22b018ccc2c9adf565ae1ac9b536e184ea
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends libseccomp2 git ffmpeg antiword ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin mastermind
WORKDIR /app
COPY requirements.worker.lock /app/requirements.worker.lock
RUN pip install --no-cache-dir -r requirements.worker.lock
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/mastermind/browser
RUN python -m playwright install-deps chromium && rm -rf /var/lib/apt/lists/*
COPY --from=browser /browser /opt/mastermind/browser
COPY worker-browser.lock.json /app/worker-browser.lock.json
COPY src /app/src
COPY runtime/worker-chromium /app/runtime/worker-chromium
RUN chmod 755 /app/runtime/worker-chromium
COPY embedding-model.lock.json /app/embedding-model.lock.json
COPY --from=embedding model.onnx tokenizer.json /opt/mastermind/model/
ENV PYTHONPATH=/app/src PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
USER 10001:10001
ENTRYPOINT ["python", "-m", "uvicorn", "mastermind.worker:create_app", "--factory", "--host", "0.0.0.0", "--port", "8092", "--no-access-log"]
