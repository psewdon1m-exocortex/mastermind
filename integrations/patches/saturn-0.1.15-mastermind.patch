+      const fragmentBytes = result.f_frsize || result.f_bsize;
+      return {
+        totalBytes: fragmentBytes * result.f_blocks,
+        availableBytes: fragmentBytes * result.f_bavail,
+      };
+    });
+  }
+
+  close(): Promise<void> {
+    return this.#pool.close();
+  }
